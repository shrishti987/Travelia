<% layout("/layouts/boilerplate") %>

<section class="home-hero">
  <div class="home-hero-content">
    <p class="eyebrow">Travelia</p>
    <h1>Book distinctive stays with confidence.</h1>
    <p>Explore verified homes, save favorites, review trips, and pay securely from one clean travel workspace.</p>
    <form action="/search" method="GET" class="home-search">
      <input type="search" name="q" placeholder="Search destination or stay" class="form-control">
      <button class="btn btn-dark" type="submit">Search</button>
    </form>
  </div>
</section>

<section class="page-shell">
  <div class="dashboard-metrics">
    <div class="metric-card"><span>Verified stays</span><strong>Curated</strong></div>
    <div class="metric-card"><span>Payments</span><strong>Secure</strong></div>
    <div class="metric-card"><span>Planning</span><strong>Simple</strong></div>
  </div>
  <div class="split-heading page-heading">
    <div>
      <p class="eyebrow">Start browsing</p>
      <h1>Premium stays, practical tools.</h1>
      <p>Travelia now supports wishlists, booking history, reviews, filters, and payment-ready reservations.</p>
    </div>
    <a href="/listings" class="btn btn-dark">Explore listings</a>
  </div>
</section>
