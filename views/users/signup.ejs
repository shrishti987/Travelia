<% layout("layouts/boilerplate") %>

<section class="auth-shell">
  <div class="auth-panel surface-panel">
    <div class="panel-body">
      <p class="eyebrow">Start planning</p>
      <h1>Create your account</h1>
      <form method="POST" action="/signup" class="auth-form">
        <label>
          Username
          <input type="text" name="username" class="form-control" placeholder="Choose a username" minlength="3" required>
        </label>
        <label>
          Email
          <input type="email" name="email" class="form-control" placeholder="you@example.com" required>
        </label>
        <label>
          Role
          <select name="role" class="form-select">
            <option value="tourist">Tourist</option>
            <option value="host">Host</option>
            <option value="vendor">Vendor</option>
            <option value="organizer">Event Organizer</option>
          </select>
        </label>
        <label>
          Password
          <input type="password" name="password" class="form-control" placeholder="At least 8 characters" minlength="8" required>
        </label>
        <button class="btn btn-dark w-100" type="submit">Sign up</button>
      </form>
      <p class="auth-alt">Already have an account? <a href="/login">Login</a></p>
    </div>
  </div>
</section>
