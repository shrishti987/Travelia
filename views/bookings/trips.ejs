<% layout("/layouts/boilerplate") %>

<section class="page-shell">
  <div class="page-heading split-heading">
    <div>
      <p class="eyebrow">Booking history</p>
      <h1>Your trips</h1>
      <p>Past and upcoming stays linked to your account.</p>
    </div>
    <a href="/listings" class="btn btn-dark">Explore stays</a>
  </div>

  <% if (bookings.length === 0) { %>
    <div class="empty-panel">
      <h2>No trips yet</h2>
      <p>When you book a stay, it will appear here with payment status and dates.</p>
    </div>
  <% } else { %>
    <div class="trip-list">
      <% bookings.forEach((booking) => { %>
        <article class="trip-row">
          <img
            src="<%= booking.listing?.image?.url || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?w=500' %>"
            alt="<%= booking.listing?.title || 'Booked stay' %>"
          >
          <div>
            <h2><%= booking.listing?.title || "Listing unavailable" %></h2>
            <p><%= booking.listing?.location || "Location unavailable" %></p>
            <p><%= new Date(booking.checkIn).toDateString() %> to <%= new Date(booking.checkOut).toDateString() %></p>
          </div>
          <div class="trip-status">
            <span class="status-pill"><%= booking.status %></span>
            <span class="status-pill <%= booking.paymentStatus === 'paid' ? 'status-paid' : 'status-pending' %>"><%= booking.paymentStatus %></span>
            <strong>Rs. <%= Number(booking.totalPrice).toLocaleString("en-IN") %></strong>
            <% if (booking.paymentStatus !== "paid") { %>
              <a href="/payments/<%= booking._id %>/checkout" class="btn btn-outline-dark btn-sm">Pay now</a>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>
