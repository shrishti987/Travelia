<% layout("layouts/boilerplate") %>
<%
  const activeFilters = typeof filters !== "undefined" ? filters : {};
  const sortValue = typeof activeSort !== "undefined" ? activeSort : (activeFilters.sort || "newest");
  const totalListings = Array.isArray(listings) ? listings.length : 0;
  const verifiedCount = totalListings ? listings.filter((listing) => !listing.isFraud).length : 0;
  const averagePrice = totalListings
    ? Math.round(listings.reduce((sum, listing) => sum + Number(listing.price || 0), 0) / totalListings)
    : 0;
  const bestRating = totalListings
    ? Math.max(...listings.map((listing) => Number(listing.avgRating || 0)))
    : 0;
  const filterChips = [
    activeFilters.q ? "Keyword: " + activeFilters.q : "",
    activeFilters.location ? "Location: " + activeFilters.location : "",
    activeFilters.country ? "Country: " + activeFilters.country : "",
    activeFilters.category ? "Category: " + activeFilters.category : "",
    activeFilters.minPrice ? "Min Rs. " + Number(activeFilters.minPrice).toLocaleString("en-IN") : "",
    activeFilters.maxPrice ? "Max Rs. " + Number(activeFilters.maxPrice).toLocaleString("en-IN") : ""
  ].filter(Boolean);
%>

<section class="page-shell">
  <div class="page-heading split-heading">
    <div>
      <p class="eyebrow"><%= typeof isRecommendation !== 'undefined' ? 'Recommended for you' : 'Stay discovery' %></p>
      <h1>Book verified stays with intelligence around every choice.</h1>
      <p><%= listings.length %> stay<%= listings.length !== 1 ? "s" : "" %> available with booking, reviews, impact signals, and trip add-ons.</p>
    </div>
    <div class="action-row">
      <a href="/planner" class="btn btn-outline-dark"><i class="fa-solid fa-wand-magic-sparkles"></i> AI plan</a>
      <a href="/listings/new" class="btn btn-dark"><i class="fa-solid fa-house-circle-check"></i> List your stay</a>
    </div>
  </div>

  <div class="discovery-insights">
    <article>
      <span>Results</span>
      <strong><%= totalListings %></strong>
    </article>
    <article>
      <span>Verified</span>
      <strong><%= verifiedCount %></strong>
    </article>
    <article>
      <span>Avg. nightly</span>
      <strong>Rs. <%= averagePrice.toLocaleString("en-IN") %></strong>
    </article>
    <article>
      <span>Top rating</span>
      <strong><%= bestRating ? bestRating.toFixed(1) : "New" %></strong>
    </article>
  </div>

  <form action="/search" method="GET" class="filter-panel">
    <input type="search" name="q" class="form-control" placeholder="Keyword" value="<%= activeFilters.q || '' %>">
    <input type="text" name="location" class="form-control" placeholder="Location" value="<%= activeFilters.location || '' %>">
    <input type="number" name="minPrice" class="form-control" placeholder="Min price" value="<%= activeFilters.minPrice || '' %>">
    <input type="number" name="maxPrice" class="form-control" placeholder="Max price" value="<%= activeFilters.maxPrice || '' %>">
    <select name="category" class="form-select">
      <option value="">All categories</option>
      <% ["Beach", "Mountains", "City", "Camping", "Islands"].forEach((category) => { %>
        <option value="<%= category %>" <%= activeFilters.category === category ? "selected" : "" %>><%= category %></option>
      <% }) %>
    </select>
    <select name="sort" class="form-select">
      <option value="newest" <%= sortValue === "newest" ? "selected" : "" %>>Newest</option>
      <option value="rating" <%= sortValue === "rating" ? "selected" : "" %>>Top rated</option>
      <option value="price_asc" <%= sortValue === "price_asc" ? "selected" : "" %>>Price low</option>
      <option value="price_desc" <%= sortValue === "price_desc" ? "selected" : "" %>>Price high</option>
    </select>
    <button class="btn btn-dark" type="submit"><i class="fa-solid fa-sliders"></i> Filter</button>
  </form>

  <% if (filterChips.length > 0) { %>
    <div class="filter-chips" aria-label="Active filters">
      <% filterChips.forEach((chip) => { %>
        <span><%= chip %></span>
      <% }) %>
      <a href="/listings">Clear all</a>
    </div>
  <% } %>

  <% if (typeof isRecommendation !== 'undefined') { %>
    <div class="info-banner">Curated from your viewed listings, category preferences, and recent demand signals.</div>
  <% } %>

  <div class="result-toolbar">
    <p><strong><%= totalListings %></strong> stay<%= totalListings !== 1 ? "s" : "" %> shown</p>
    <div class="density-toggle" aria-label="Listing density">
      <button type="button" class="active" data-density="comfort" aria-label="Comfort view" title="Comfort view"><i class="fa-solid fa-grip"></i></button>
      <button type="button" data-density="compact" aria-label="Compact view" title="Compact view"><i class="fa-solid fa-table-cells-large"></i></button>
    </div>
  </div>

  <div class="search-layout">
    <div>
      <% if (!listings || listings.length === 0) { %>
        <div class="empty-panel">
          <h2>No listings found</h2>
          <p>Try a broader destination, lower price range, or a different category.</p>
        </div>
      <% } else { %>
        <div class="listing-grid compact-grid" id="listingGrid">
          <% listings.forEach((listing, index) => { %>
            <% const isSaved = wishlistIds.includes(listing._id.toString()); %>
            <% const ecoScore = 72 + ((Number(listing.price) + index * 7) % 23); %>
            <% const impactValue = Math.max(900, Math.round(Number(listing.price || 0) * 0.18)); %>
            <article class="stay-card">
              <a href="/listings/<%= listing._id %>" class="image-link">
                <img
                  src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?w=700&auto=format&fit=crop' %>"
                  alt="<%= listing.title %>"
                  loading="<%= index === 0 ? 'eager' : 'lazy' %>"
                  decoding="async"
                  fetchpriority="<%= index === 0 ? 'high' : 'auto' %>"
                >
              </a>

              <div class="card-badges">
                <span><i class="fa-solid fa-star"></i> <%= listing.avgRating ? listing.avgRating.toFixed(1) : "New" %></span>
                <span><i class="fa-solid fa-leaf"></i> <%= ecoScore %></span>
                <% if (!listing.isFraud) { %>
                  <span>Verified</span>
                <% } else { %>
                  <span class="risk">Review needed</span>
                <% } %>
              </div>

              <form action="/wishlist/<%= listing._id %>/toggle" method="POST" class="floating-form">
                <button class="icon-button <%= isSaved ? 'saved' : '' %>" type="submit" aria-label="<%= isSaved ? 'Remove from wishlist' : 'Save to wishlist' %>">
                  <i class="<%= isSaved ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
                </button>
              </form>

              <div class="stay-card-body">
                <div>
                  <p class="card-kicker"><%= listing.location %>, <%= listing.country %></p>
                  <h2><a href="/listings/<%= listing._id %>"><%= listing.title %></a></h2>
                  <small class="impact-note">Rs. <%= impactValue.toLocaleString("en-IN") %> estimated local impact per night</small>
                </div>
                <p class="price-line">Rs. <%= Number(listing.price).toLocaleString("en-IN") %> <span>/ night</span></p>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </div>

    <aside class="surface-panel search-map-panel">
      <div class="travelia-mini-map" data-lat="30.3165" data-lng="78.0322"></div>
      <div class="panel-body">
        <p class="eyebrow">Interactive map</p>
        <h2>Destination graph</h2>
        <p class="muted">Pair stays with nearby activities, event inventory, emergency support, and local pickup points.</p>
        <a href="/planner" class="btn btn-outline-dark w-100">Optimize route</a>
      </div>
    </aside>
  </div>
</section>
