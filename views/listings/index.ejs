<% layout("layouts/boilerplate") %>

<section class="page-shell">
  <div class="page-heading split-heading">
    <div>
      <p class="eyebrow"><%= typeof isRecommendation !== 'undefined' ? 'Recommended for you' : 'Explore stays' %></p>
      <h1>Find a stay that fits the trip</h1>
      <p><%= listings.length %> place<%= listings.length !== 1 ? "s" : "" %> available</p>
    </div>
    <a href="/listings/new" class="btn btn-dark">List your stay</a>
  </div>

  <form action="/search" method="GET" class="filter-panel">
    <input type="search" name="q" class="form-control" placeholder="Keyword" value="<%= typeof filters !== 'undefined' && filters.q ? filters.q : '' %>">
    <input type="text" name="location" class="form-control" placeholder="Location" value="<%= typeof filters !== 'undefined' && filters.location ? filters.location : '' %>">
    <input type="number" name="minPrice" class="form-control" placeholder="Min price" value="<%= typeof filters !== 'undefined' && filters.minPrice ? filters.minPrice : '' %>">
    <input type="number" name="maxPrice" class="form-control" placeholder="Max price" value="<%= typeof filters !== 'undefined' && filters.maxPrice ? filters.maxPrice : '' %>">
    <select name="category" class="form-select">
      <option value="">All categories</option>
      <% ["Beach", "Mountains", "City", "Camping", "Islands"].forEach((category) => { %>
        <option value="<%= category %>" <%= typeof filters !== 'undefined' && filters.category === category ? "selected" : "" %>><%= category %></option>
      <% }) %>
    </select>
    <button class="btn btn-dark" type="submit">Filter</button>
  </form>

  <% if (typeof isRecommendation !== 'undefined') { %>
    <div class="info-banner">Curated from your viewed listings and category preferences.</div>
  <% } %>

  <% if (!listings || listings.length === 0) { %>
    <div class="empty-panel">
      <h2>No listings found</h2>
      <p>Try a broader destination, lower price range, or a different category.</p>
    </div>
  <% } else { %>
    <div class="listing-grid">
      <% listings.forEach((listing) => { %>
        <% const isSaved = wishlistIds.includes(listing._id.toString()); %>
        <article class="stay-card">
          <a href="/listings/<%= listing._id %>" class="image-link">
            <img src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?w=700' %>" alt="<%= listing.title %>" loading="lazy">
          </a>

          <div class="card-badges">
            <span><i class="fa-solid fa-star"></i> <%= listing.avgRating ? listing.avgRating.toFixed(1) : "New" %></span>
            <% if (!listing.isFraud) { %>
              <span>Verified</span>
            <% } else { %>
              <span class="risk">Review needed</span>
            <% } %>
          </div>

          <form action="/wishlist/<%= listing._id %>/toggle" method="POST" class="floating-form">
            <button class="icon-button <%= isSaved ? 'saved' : '' %>" type="submit" aria-label="<%= isSaved ? 'Remove from wishlist' : 'Save to wishlist' %>">
              <i class="<%= isSaved ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
            </button>
          </form>

          <div class="stay-card-body">
            <div>
              <p class="card-kicker"><%= listing.location %>, <%= listing.country %></p>
              <h2><a href="/listings/<%= listing._id %>"><%= listing.title %></a></h2>
            </div>
            <p class="price-line">Rs. <%= Number(listing.price).toLocaleString("en-IN") %> <span>/ night</span></p>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>
