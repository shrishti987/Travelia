<% layout("/layouts/boilerplate") %>

<section class="page-shell narrow-shell">
  <div class="page-heading">
    <p class="eyebrow">Host tools</p>
    <h1>Edit listing</h1>
    <p>Keep pricing, images, and stay details current.</p>
  </div>

  <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="surface-panel panel-body auth-form needs-validation">
    <label>Title
      <input name="listing[title]" value="<%= listing.title %>" type="text" class="form-control" required>
    </label>

    <label>Description
      <textarea name="listing[description]" class="form-control" rows="5" required><%= listing.description %></textarea>
    </label>

    <label>Image URL
      <input name="listing[image]" value="<%= listing.image?.url || '' %>" type="url" class="form-control">
    </label>

    <div class="row g-3">
      <div class="col-md-4">
        <label>Price
          <input name="listing[price]" value="<%= listing.price %>" type="number" class="form-control" min="0" required>
        </label>
      </div>
      <div class="col-md-8">
        <label>Country
          <input name="listing[country]" value="<%= listing.country %>" type="text" class="form-control" required>
        </label>
      </div>
    </div>

    <label>Category
      <select name="listing[category]" class="form-select" required>
        <% ["Beach", "Mountains", "City", "Camping", "Islands"].forEach((category) => { %>
          <option value="<%= category %>" <%= listing.category === category ? "selected" : "" %>><%= category %></option>
        <% }) %>
      </select>
    </label>

    <label>Location
      <input name="listing[location]" value="<%= listing.location %>" type="text" class="form-control" required>
    </label>

    <button class="btn btn-dark" type="submit">Save changes</button>
  </form>
</section>
