<% layout("layouts/boilerplate") %>

<section class="page-shell narrow-shell">
  <div class="page-heading">
    <p class="eyebrow">Host on Travelia</p>
    <h1>Create a listing</h1>
    <p>Add the details travelers need to confidently book your stay.</p>
  </div>

  <form method="POST" action="/listings" enctype="multipart/form-data" class="surface-panel panel-body auth-form">
    <label>Title
      <input name="listing[title]" placeholder="Modern hillside villa" type="text" class="form-control" required>
    </label>

    <label>Description
      <textarea name="listing[description]" class="form-control" rows="4" placeholder="Describe the stay, amenities, and nearby highlights" required></textarea>
    </label>

    <label>Upload image
      <input type="file" name="image" class="form-control" accept="image/*">
    </label>

    <div class="row g-3">
      <div class="col-md-4">
        <label>Price
          <input name="listing[price]" placeholder="4500" type="number" class="form-control" min="0" required>
        </label>
      </div>
      <div class="col-md-8">
        <label>Country
          <input name="listing[country]" placeholder="India" type="text" class="form-control" required>
        </label>
      </div>
    </div>

    <label>Category
      <select name="listing[category]" class="form-select" required>
        <option value="">Select category</option>
        <option value="Beach">Beach</option>
        <option value="Mountains">Mountains</option>
        <option value="City">City</option>
        <option value="Camping">Camping</option>
        <option value="Islands">Islands</option>
      </select>
    </label>

    <label>Location
      <input name="listing[location]" placeholder="Dehradun, Uttarakhand" type="text" class="form-control" required>
    </label>

    <button class="btn btn-dark" type="submit">Add listing</button>
  </form>
</section>
