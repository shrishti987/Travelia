<% layout("layouts/boilerplate") %>
<% const ecoScore = 78 + (Number(listing.price || 0) % 17); %>
<% const localImpact = Math.max(1200, Math.round(Number(listing.price || 0) * 0.22)); %>

<section class="page-shell show-page">
  <div class="page-heading split-heading">
    <div>
      <p class="eyebrow"><%= listing.category %> - <%= listing.propertyType || "Stay" %></p>
      <h1><%= listing.title %></h1>
      <p><%= listing.location %>, <%= listing.country %></p>
    </div>
    <div class="rating-chip">
      <i class="fa-solid fa-star"></i>
      <span><%= listing.avgRating ? listing.avgRating.toFixed(1) : "New" %></span>
    </div>
  </div>

  <div class="image-grid">
    <img src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?w=1200&auto=format&fit=crop' %>" alt="<%= listing.title %>" decoding="async" fetchpriority="high">
    <img src="https://images.unsplash.com/photo-1512918728675-ed5a9ecdebfd?w=900&auto=format&fit=crop" alt="" loading="lazy" decoding="async">
    <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=900&auto=format&fit=crop" alt="" loading="lazy" decoding="async">
  </div>

  <div class="show-grid">
    <article class="surface-panel">
      <div class="panel-body">
        <% if (listing.isFraud) { %>
          <div class="alert alert-danger">This listing needs review: <%= listing.fraudReason %></div>
        <% } else { %>
          <div class="info-banner">Verified stay with host, payment, and review checks.</div>
        <% } %>

        <h2>About this stay</h2>
        <p><%= listing.description %></p>

        <div class="detail-list">
          <span><strong>Category</strong><%= listing.category %></span>
          <span><strong>Nightly rate</strong>Rs. <%= Number(listing.price).toLocaleString("en-IN") %></span>
          <span><strong>Rating</strong><%= listing.avgRating ? listing.avgRating.toFixed(1) : "No ratings yet" %></span>
          <span><strong>Eco score</strong><%= ecoScore %>/100</span>
          <span><strong>Local impact</strong>Rs. <%= localImpact.toLocaleString("en-IN") %>/night</span>
          <span><strong>Weather fit</strong>Morning activities preferred</span>
        </div>
      </div>
    </article>

    <aside class="surface-panel booking-panel">
      <div class="panel-body">
        <h2>Reserve this stay</h2>
        <p class="price-line large">Rs. <%= Number(listing.price).toLocaleString("en-IN") %> <span>/ night</span></p>
        <form action="/listings/<%= listing._id %>/book" method="POST" class="booking-form" data-nightly-rate="<%= Number(listing.price || 0) %>">
          <label>
            Check in
            <input type="date" name="checkIn" class="form-control" required>
          </label>
          <label>
            Check out
            <input type="date" name="checkOut" class="form-control" required>
          </label>
          <button class="btn btn-dark w-100" type="submit"><i class="fa-solid fa-credit-card"></i> Continue to payment</button>
        </form>
        <div class="booking-estimate" aria-live="polite">
          <span>Estimated total</span>
          <strong data-booking-total>Choose dates</strong>
          <small data-booking-nights></small>
        </div>
        <div class="side-action-stack">
          <a href="/cart" class="btn btn-outline-dark w-100"><i class="fa-solid fa-cart-plus"></i> Add to trip cart</a>
          <button
            class="btn btn-outline-dark w-100 js-share-listing"
            type="button"
            data-title="<%= listing.title %>"
            data-path="/listings/<%= listing._id %>"
          >
            <i class="fa-solid fa-share-nodes"></i> Share stay
          </button>
        </div>
      </div>
    </aside>
  </div>

  <div class="show-grid">
    <section class="surface-panel">
      <div class="panel-body">
        <div class="split-heading">
          <div>
            <p class="eyebrow">Trip intelligence</p>
            <h2>Recommended add-ons</h2>
          </div>
          <a href="/planner" class="text-link">Open planner</a>
        </div>
        <div class="addon-grid">
          <a href="/experiences"><i class="fa-solid fa-person-hiking"></i><strong>Ridge trek</strong><span>6 hours - weather-safe window</span></a>
          <a href="/events"><i class="fa-solid fa-ticket"></i><strong>Local evening event</strong><span>QR ticket - pickup nearby</span></a>
          <a href="/marketplace"><i class="fa-solid fa-store"></i><strong>Craft pickup</strong><span>Supports local vendors</span></a>
          <a href="/sos"><i class="fa-solid fa-kit-medical"></i><strong>Safety center</strong><span>Emergency contacts ready</span></a>
        </div>
      </div>
    </section>

    <section class="surface-panel">
      <div class="panel-body">
        <h2>Location</h2>
        <div
          id="map"
          class="map-box travelia-detail-map"
          data-lat="<%= listing.latitude || 30.3165 %>"
          data-lng="<%= listing.longitude || 78.0322 %>"
          data-label="<%= listing.title %>"
        ></div>
      </div>
    </section>
  </div>

  <div class="show-grid">
    <section class="surface-panel">
      <div class="panel-body">
        <h2>Reviews</h2>
        <% if (!currUser) { %>
          <p class="muted">Log in to leave a review.</p>
        <% } else { %>
          <form action="/listings/<%= listing._id %>/reviews" method="POST" class="review-form">
            <select name="review[rating]" class="form-select" required>
              <option value="">Rating</option>
              <option value="5">5 stars</option>
              <option value="4">4 stars</option>
              <option value="3">3 stars</option>
              <option value="2">2 stars</option>
              <option value="1">1 star</option>
            </select>
            <textarea name="review[comment]" class="form-control" rows="3" placeholder="Share what stood out" required></textarea>
            <button class="btn btn-outline-dark" type="submit">Submit review</button>
          </form>
        <% } %>

        <% if (listing.reviews.length === 0) { %>
          <p class="muted mt-3">No reviews yet.</p>
        <% } %>

        <% listing.reviews.forEach((review) => { %>
          <article class="review-card">
            <div>
              <strong><%= review.author?.username || "Traveler" %></strong>
              <span><i class="fa-solid fa-star"></i> <%= review.rating %>/5</span>
            </div>
            <p><%= review.comment %></p>
          </article>
        <% }) %>
      </div>
    </section>

    <section class="surface-panel">
      <div class="panel-body">
        <h2>Community impact</h2>
        <div class="score-bars">
          <span><strong>Host payout</strong><i style="--value: 82%"></i></span>
          <span><strong>Local sourcing</strong><i style="--value: 74%"></i></span>
          <span><strong>Low-waste practices</strong><i style="--value: 68%"></i></span>
        </div>
      </div>
    </section>
  </div>
</section>
