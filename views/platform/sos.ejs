<% layout("layouts/boilerplate") %>

<section class="page-shell sos-page">
  <div class="sos-hero surface-panel">
    <div class="panel-body">
      <p class="eyebrow">SOS Emergency Assistance</p>
      <h1>Traveler safety center</h1>
      <p>One place for emergency contacts, live location sharing, medical notes, embassy details, and trip support escalation.</p>
      <div class="sos-actions">
        <a href="tel:112" class="btn btn-danger"><i class="fa-solid fa-phone"></i> Call 112</a>
        <a href="/dashboard" class="btn btn-outline-dark"><i class="fa-solid fa-location-dot"></i> Share trip status</a>
      </div>
    </div>
  </div>

  <div class="safety-grid">
    <article class="surface-panel panel-body">
      <h2>Current trip</h2>
      <p class="muted">Cedar Glasshouse, Himachal Pradesh</p>
      <div class="history-row"><span>Nearest hospital</span><strong>18 min</strong></div>
      <div class="history-row"><span>Weather alert</span><strong>Clear</strong></div>
      <div class="history-row"><span>Host response SLA</span><strong>Under 5 min</strong></div>
    </article>
    <article class="surface-panel panel-body">
      <h2>Trusted contacts</h2>
      <div class="history-row"><span>Primary contact</span><strong>Ready</strong></div>
      <div class="history-row"><span>Travelia support</span><strong>24/7</strong></div>
      <div class="history-row"><span>Local partner</span><strong>Online</strong></div>
    </article>
  </div>
</section>
